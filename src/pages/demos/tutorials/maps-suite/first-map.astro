---
// tutorials/maps-suite/first-map の動くデモ（iframe 埋め込み用）。
// 命令型 API。バンドルされるモジュール script でクライアント実行する。
// チュートリアル本文と同じコード（apiKey のみ）。
import DemoLayout from '../../../../layouts/DemoLayout.astro';
---
<DemoLayout title="maps-suite — 地図を出す">
  <div id="map"></div>
  <script>
    import 'maplibre-gl/dist/maplibre-gl.css';
    import '@geolonia/maps-core/css';
    import { geolonia } from '@geolonia/maps-suite';

    new geolonia.maps.Map(document.getElementById('map'), {
      apiKey: 'YOUR-API-KEY',
    });
  </script>
</DemoLayout>
